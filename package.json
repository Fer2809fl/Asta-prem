{
  "name": "Asta-prem",
  "version": "1.0.0",
  "description": "Runtime oficial de Termux para conectar un Sub-Bot de Asta-Bot a la API central",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "asta-runtime": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "postinstall": "node -e \"try{require('fs').mkdirSync('data',{recursive:true})}catch(e){}\""
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "axios": "^1.18.1",
    "baileysx": "git+https://github.com/Fer2809fl/bail.git",
    "pino": "^9.4.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}
